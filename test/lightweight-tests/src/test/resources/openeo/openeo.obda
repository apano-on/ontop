[PrefixDeclaration]
:		http://www.unibz-openeo.org#
geo:		http://www.opengis.net/ont/geosparql#
owl:		http://www.w3.org/2002/07/owl#
rdf:		http://www.w3.org/1999/02/22-rdf-syntax-ns#
xml:		http://www.w3.org/XML/1998/namespace
xsd:		http://www.w3.org/2001/XMLSchema#
rdfs:		http://www.w3.org/2000/01/rdf-schema#
sosa:		http://www.w3.org/ns/sosa/
openeo:		http://www.openeo-ontop.org#

[MappingDeclaration] @collection [[
mappingId	vector_data_wildfires_southtyrol
target		:regionST/{"istat_code_t"} a :SouthTyrolMuni ; geo:asWKT {"geom1"}^^geo:wktLiteral ; rdfs:label {"name_it"}@it ; rdfs:label {"name_de"}@de ; :belongsToDistrict {"distr_it"}@it .
source		select TRIM_SCALE("istat_code")::TEXT AS "istat_code_t", "name_it", "name_de", "distr_it", ST_AsText(ST_Transform("geom", 4326)) as "geom1" from municipalities_polygon
]]